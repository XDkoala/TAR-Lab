# Copy to ~/.config/tar-lab/email.env (chmod 600). Never commit the real file.
# 163 Mail: Settings -> POP3/SMTP/IMAP -> enable SMTP, then create an authorization code.
TARLAB_SMTP_HOST=smtp.163.com
TARLAB_SMTP_PORT=465
TARLAB_SMTP_USER=you@163.com
# The authorization code, not your login password.
TARLAB_SMTP_PASSWORD=
# Optional; defaults to TARLAB_SMTP_USER.
TARLAB_SMTP_TO=you@163.com
